{
  "name": "helloid-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server for HelloID Provisioning, through the admin session of the person using it",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch-path=src src/index.ts",
    "cli": "node dist/cli.js",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "puppeteer-core": "^25.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
